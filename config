fullscreen = true
shell-integration = zsh

theme=Belafonte Night

#background-opacity = 0.9
#background-blur-radius = 20
background = #000000
#background-blur = true

background-image = ~/Pictures/wallpapers/g.png
background-image-opacity = 0.01
background-image-fit = cover

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

clipboard-paste-protection = false

keybind = alt+shift+r=reload_config
keybind = alt+shift+l=new_split:right
keybind = alt+shift+h=new_split:left
keybind = alt+shift+j=new_split:down
keybind = alt+shift+k=new_split:up
keybind = alt+shift+w=close_surface
keybind = alt+l=goto_split:right
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+shift+e=equalize_splits

font-size = 11
font-family = JetBrainsMonoNL Nerd Font
#font-family-bold = Fira Code Bold
font-style = Medium

confirm-close-surface = false

mouse-hide-while-typing = true
cursor-style = block
cursor-style-blink = true

custom-shader = shaders/smear.glsl
